}
pub part R_10K: ChipResistor<10kohm, 1%> {
    primary { mfr: "Yageo", mpn: "RC0402FR-0710KL", footprint: CHIP_0402 }
}
pub part R_1K: ChipResistor<1kohm, 1%> {
    primary { mfr: "Yageo", mpn: "RC0402FR-071KL", footprint: CHIP_0402 }
}
pub part C_100n: MLCC<100nF, 16V, 10%>[C0402] {
    primary { mfr: "Samsung", mpn: "CL05B104KO5NNNC", footprint: CHIP_0402 }
}
pub part C_1u: MLCC<1uF, 10V, 10%>[C0402] {
    primary { mfr: "Murata", mpn: "GRM155R61A105KE15D", footprint: CHIP_0402 }
}
pub part C_4u7: MLCC<4.7uF, 10V, 20%>[C0603] {
