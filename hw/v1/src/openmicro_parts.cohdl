// OpenMicro — board-specific devices and part bindings (STM32F072 macropad).
// Pinouts datasheet-verified (Alps — see docs/compliance-report.md). Reuses std
// traits and library components.

// ---- designator-prefix traits not in std ----
pub trait Switch {
    designator_prefix: "SW"
}
pub trait Encoder {
    designator_prefix: "SW"
}
pub trait TestPad {
    designator_prefix: "TP"
}

// ---- Kailh Choc V2 low-profile keyswitch (MX cross stem): 2 non-polar
// electrical contacts plus the fixing leg. The central box-stem hole stays an
// RFC-022 mount_hole (a plastic boss passes through it, nothing to solder), but
// the LEG is metal and its hole is plated, so it is a real pad — and therefore
// a real pin, since a footprint's pad set must match its device's (E807).
//
// `optional`, because the leg carries no signal: it is a mechanical anchor, and
// declaring it required would oblige all 13 switches to wire a pin that has
// nothing to connect to. ----
pub device KeySwitch {
    pins {
        required A: 1 [passive]
        required B: 2 [passive]
        optional MNT: 3 [passive]
    }
}
impl Switch for KeySwitch {}
pub part SW_KEY: KeySwitch {
    primary { mfr: "Work Louder", mpn: "WL-LP-SW-55G", footprint: FP_SW_Choc_V2 }
}

// ---- Alps EC11 rotary encoder + push. A/B quadrature, C = common/GND;
// SW1/SW2 = push switch; MNT = mechanical mounting posts. ----
pub device RotaryEC11 {
    pins {
        required A: 1 [output]
        required C: 2 [passive]
        required B: 3 [output]
        required SW1: 4 [passive]
        required SW2: 5 [passive]
        required MNT: 6, 7 [passive]
    }
}
impl Encoder for RotaryEC11 {}
pub part ENC_EC11: RotaryEC11 {
    primary { mfr: "Alps Alpine", mpn: "EC11E15244A5", footprint: FP_Encoder_EC11 }
}

// ---- Alps RKJXV122400R ThumbPointer: two 10k B-taper potentiometers plus a
// centre-push switch, ten terminals in three groups (see FP_Joystick_RKJXV).
// Terminal 2 of each potentiometer is the wiper — the datasheet measures total
// resistance "between the resistor terminals 1 and 3". X is carried by VR1 and
// Y by VR2; which physical axis each senses is a firmware convention, not a
// datasheet fact, so the naming here is ours.
//
// The switch's four terminals pair BY ROW, not by side. The land is the
// standard 6.5 x 4.5 tact-switch pattern, and a tact switch's two stamped
// contact frames each exit as the two same-row legs 6.5mm apart: a+c are one
// pole, b+d the other, the 4.5mm row spacing separating the poles. Pairing by
// side (a+b / c+d) puts BOTH poles on each net, so JOY_SW is held at GND
// through the switch body and the push never produces an edge — the same
// column-grouping trap the footprint audit caught on the EVQ-P7A reset
// switch this board used to carry.
//
// MNT = the metal frame's four soldered corner lugs (the datasheet's "Solder
// all metal inserted fixing including terminals & metal lugs"), one pin
// claiming four pads, the same shape the EC11's mounting posts use. Tied to
// GND at the board level for the same chassis-bonding reason. ----
pub device ThumbPointer {
    pins {
        required X_END_A: A1 [passive]
        required X_WIPER: A2 [output]
        required X_END_B: A3 [passive]
        required Y_END_A: B1 [passive]
        required Y_WIPER: B2 [output]
        required Y_END_B: B3 [passive]
        required SW_A: SA, SC [passive]
        required SW_B: SB, SD [passive]
        optional MNT: L1, L2, L3, L4 [passive]
    }
}
impl Connector for ThumbPointer {}
pub part JOY_RKJXV: ThumbPointer {
    primary { mfr: "Alps Alpine", mpn: "RKJXV122400R", footprint: FP_Joystick_RKJXV }
}

// ---- capacitive-touch sense pad (bare copper, sensed by the STM32). ----
pub device CapTouchPad {
    pins {
        required PAD: 1 [passive]
    }
}
impl TestPad for CapTouchPad {}
pub part TOUCH_PAD: CapTouchPad {
    primary { mfr: "n/a", mpn: "COPPER-TOUCH-9MM", footprint: FP_TouchPad }
}

// ---- M2 mounting hole (plated barrel tied to GND for chassis bonding to the
// aluminum standoffs). One pad = the plated hole. ----
pub trait MountHole {
    designator_prefix: "H"
}
pub device MountingHole {
    pins {
        required PAD: 1 [passive]
    }
}
impl MountHole for MountingHole {}
pub part MH_M2: MountingHole {
    primary { mfr: "n/a", mpn: "MOUNT-M2-PLATED-2.2MM", footprint: FP_MountingHole_M2 }
}

// reusable decoupling sub-circuit
pub fn decouple(vdd: Pin, gnd: Pin) {
    // RFC-028: ONE attribute here annotates every call site's capacitor —
    // each expansion resolves `vdd` to that call's real (instance, pin), one
    // bypass_capacitors.csv row per pad of the bypassed pin.
    #[bypass(vdd, 100nF)]
    inst c: passive::C_100n_16V_X7R_0402
    net _: vdd, c.A
    net _: gnd, c.B
}
