// OpenMicro — an open-source STM32F072 clone of the OpenAI Codex Micro
// macropad (13 keys, rotary dial, analog joystick, cap-touch, per-key RGB).
// Wired USB-C. Every footprint datasheet-verified (see docs/README.md).

design OpenMicro {
    // ---- major devices ----
    inst mcu: st_stm32::f0::stm32f072cb::MCU_STM32F072
    inst usbc: usb::connectors::type_c::USB_C_HRO_TYPE_C_31_M_12
    inst esd: esd::ESD_USBLC6
    inst ldo: ldo::LDO_AP2112K_3V3
    inst enc: ENC_EC11
    inst joy: JOY_RKJXV
    inst touch: TOUCH_PAD
    inst swd: connectors::headers::smd_254::SOCKET_2X3_254_SMD

    // ---- 13 key switches + matrix diodes ----
    inst sw: [SW_KEY; 13]
    inst d: [diode::D_1N4148W; 13]
    // ---- 13 per-key RGB LEDs (SK6812MINI-E reverse-mount, one under each key,
    // at the switch's north LED window; one WS2812 chain) ----
    inst key_leds: [led::RGB_SK6812; 13]
    // ---- 8 perimeter underglow RGB LEDs (SK6812MINI-E up-firing into the
    // frosted PC frame; a SEPARATE WS2812 chain, 2 per side) ----
    inst ambient_leds: [led::RGB_SK6812; 8]

    // ---- 4 M2 mounting holes (corners; plated barrels -> GND) ----
    inst mh: [MH_M2; 4]

    // ---- passives ----
    inst rcc1: passive::R_5K1_F_0402
    inst rcc2: passive::R_5K1_F_0402
    inst rboot: passive::R_10K_F_0402
    #[crystal_oscillator(mcu, PF0, PF1)]
    inst xtal: osc::XTAL_8M
    // c_x1/c_x2 are the crystal's LOAD capacitors (oscillator tank, set CL) —
    // deliberately NOT #[bypass]: that attribute means supply decoupling, and
    // the oscillator region is already declared by #[crystal_oscillator] above.
    inst c_x1: passive::C_15p_50V_C0G_0402
    inst c_x2: passive::C_15p_50V_C0G_0402
    #[bypass(ldo.VIN, 4.7uF)]
    inst c_bulk: passive::C_4u7_10V_X5R_0603
    #[bypass(mcu.VDDA, 1uF)]
    inst c_vdda: passive::C_1u_10V_X5R_0402

    // ---- bypass capacitors ----
    // DELIBERATELY UNPLACED. Every one carries `#[bypass(target, value)]`, and
    // that attribute is exactly what the auto-placer consumes (RFC-027 ->
    // bypass_capacitors.csv): it knows which pin each cap serves and will put
    // it where the fanout actually lands. A hand-locked `place` would override
    // that with a guess made before any routing exists, so these carry no
    // coordinates and the board script stages them outside the outline.
    //
    // They are still NAMED instances rather than `decouple()` calls. A cap
    // created inside a fn has no user-visible name, so naming them is what
    // makes a per-cap `place` possible at all — worth keeping for the day one
    // of them needs to be pinned by hand, and it costs nothing today.
    #[bypass(mcu.VDD, 100nF)]
    inst c_vdd_a: passive::C_100n_16V_X7R_0402
    #[bypass(mcu.VDD, 100nF)]
    inst c_vdd_b: passive::C_100n_16V_X7R_0402
    #[bypass(mcu.VDDA, 100nF)]
    inst c_vdda_hf: passive::C_100n_16V_X7R_0402
    #[bypass(usbc.VBUS, 100nF)]
    inst c_vbus: passive::C_100n_16V_X7R_0402
    // one 100nF per key LED
    #[bypass(key_leds[0].VDD, 100nF)]
    inst c_kled0: passive::C_100n_16V_X7R_0402
    #[bypass(key_leds[1].VDD, 100nF)]
    inst c_kled1: passive::C_100n_16V_X7R_0402
    #[bypass(key_leds[2].VDD, 100nF)]
    inst c_kled2: passive::C_100n_16V_X7R_0402
    #[bypass(key_leds[3].VDD, 100nF)]
    inst c_kled3: passive::C_100n_16V_X7R_0402
    #[bypass(key_leds[4].VDD, 100nF)]
    inst c_kled4: passive::C_100n_16V_X7R_0402
    #[bypass(key_leds[5].VDD, 100nF)]
    inst c_kled5: passive::C_100n_16V_X7R_0402
    #[bypass(key_leds[6].VDD, 100nF)]
    inst c_kled6: passive::C_100n_16V_X7R_0402
    #[bypass(key_leds[7].VDD, 100nF)]
    inst c_kled7: passive::C_100n_16V_X7R_0402
    #[bypass(key_leds[8].VDD, 100nF)]
    inst c_kled8: passive::C_100n_16V_X7R_0402
    #[bypass(key_leds[9].VDD, 100nF)]
    inst c_kled9: passive::C_100n_16V_X7R_0402
    #[bypass(key_leds[10].VDD, 100nF)]
    inst c_kled10: passive::C_100n_16V_X7R_0402
    #[bypass(key_leds[11].VDD, 100nF)]
    inst c_kled11: passive::C_100n_16V_X7R_0402
    #[bypass(key_leds[12].VDD, 100nF)]
    inst c_kled12: passive::C_100n_16V_X7R_0402
    // underglow ring: one 100nF per LED PAIR (shared rail cap). At 2 LEDs per
    // side that pair is exactly one edge of the board, so this is one rail cap
    // per side.
    #[bypass(ambient_leds[0].VDD, 100nF)]
    inst c_uled0: passive::C_100n_16V_X7R_0402
    #[bypass(ambient_leds[2].VDD, 100nF)]
    inst c_uled2: passive::C_100n_16V_X7R_0402
    #[bypass(ambient_leds[4].VDD, 100nF)]
    inst c_uled4: passive::C_100n_16V_X7R_0402
    #[bypass(ambient_leds[6].VDD, 100nF)]
    inst c_uled6: passive::C_100n_16V_X7R_0402

    // ---- power in: USB-C VBUS (5V) -> ESD -> LDO -> 3V3; all 21 RGB LEDs run
    // off the 5V VBUS rail ----
    #[high_current(500mA)]
    net VBUS [5V]: usbc.VBUS, esd.VBUS, ldo.VIN, ldo.EN, c_bulk.A, c_kled0.A, c_kled1.A, c_kled2.A,
                   c_kled3.A, c_kled4.A, c_kled5.A, c_kled6.A, c_kled7.A, c_kled8.A, c_kled9.A,
                   c_kled10.A, c_kled11.A, c_kled12.A, c_uled0.A, c_uled2.A, c_uled4.A, c_uled6.A,
                   c_vbus.A, key_leds[0..=12].VDD, ambient_leds[0..=7].VDD
    #[intent("AP2112K enable tied to VIN — always on when USB is present")]
    #[high_current(500mA)]
    net V3V3 [3.3V]: ldo.VOUT, mcu.VDD, mcu.VDDA, mcu.VBAT, mcu.VDDIO2, joy.X_END_B, joy.Y_END_B,
                     c_vdda.A, c_vdd_a.A, c_vdd_b.A, c_vdda_hf.A
    #[ground(primary)]
    net GND [gnd]: usbc.GND, usbc.SHIELD, esd.GND, ldo.GND, mcu.VSS, mcu.VSSA, xtal.GND, c_x1.B,
                   c_x2.B, c_bulk.B, c_vdda.B, c_vdd_a.B, c_vdd_b.B, c_vdda_hf.B, c_vbus.B,
                   c_kled0.B, c_kled1.B, c_kled2.B, c_kled3.B, c_kled4.B, c_kled5.B, c_kled6.B,
                   c_kled7.B, c_kled8.B, c_kled9.B, c_kled10.B, c_kled11.B, c_kled12.B, c_uled0.B,
                   c_uled2.B, c_uled4.B, c_uled6.B, rcc1.B, rcc2.B, rboot.B, swd.P1, swd.P2, enc.C,
                   enc.SW2, enc.MNT, joy.X_END_A, joy.Y_END_A, joy.SW_B, joy.MNT, mh[0..=3].PAD,
                   key_leds[0..=12].GND, ambient_leds[0..=7].GND

    // ---- USB 2.0 through the ESD array (I/O1 = D+, I/O2 = D-) ----
    // DP takes the ESD's I/O2 channel and DM its I/O1 — swapped relative to the
    // obvious pin-order mapping. The USBLC6's two channels are identical, so
    // this is purely a routing choice: with U1 turned 90deg under the
    // receptacle, it puts each protected line on the side its receptacle land
    // already sits on, so the pair runs straight instead of crossing itself.
    net USBC_DP: usbc.DP, esd.IO2_A
    net USB_DP: esd.IO2_B, mcu.PA12
    net USBC_DM: usbc.DN, esd.IO1_A
    net USB_DM: esd.IO1_B, mcu.PA11
    // USB-C CC pulldowns (5.1k Rd — advertise a UFP/device sink)
    net CC1: usbc.CC1, rcc1.A
    net CC2: usbc.CC2, rcc2.A

    // ---- boot ----
    // No NRST net: the reset button is gone and the debug socket carries no
    // reset line, so NRST is left on the MCU's internal pull-up (see `nc:`).
    net BOOT0: mcu.BOOT0, rboot.A

    // ---- 8MHz HSE crystal (PF0/PF1), 15pF load caps (AN2867, CL=10pF) ----
    net HSE_IN: mcu.PF0, xtal.XIN, c_x1.A
    net HSE_OUT: mcu.PF1, xtal.XOUT, c_x2.A

    // ---- SWD debug + serial console (one 2x3 2.54mm socket) ----
    //     P1 GND | P3 SWCLK | P5 SWDIO
    //     P2 GND | P4 TXD   | P6 RXD
    net SWDIO: mcu.PA13, swd.P5
    net SWCLK: mcu.PA14, swd.P3
    net UART_TX: mcu.PB6, swd.P4
    net UART_RX: mcu.PB7, swd.P6

    // ---- keyboard matrix (COL2ROW: ROW -> switch -> diode -> COL) ----
    net KEY1: sw[0].B, d[0].Anode
    net KEY2: sw[1].B, d[1].Anode
    net KEY3: sw[2].B, d[2].Anode
    net KEY4: sw[3].B, d[3].Anode
    net KEY5: sw[4].B, d[4].Anode
    net KEY6: sw[5].B, d[5].Anode
    net KEY7: sw[6].B, d[6].Anode
    net KEY8: sw[7].B, d[7].Anode
    net KEY9: sw[8].B, d[8].Anode
    net KEY10: sw[9].B, d[9].Anode
    net KEY11: sw[10].B, d[10].Anode
    net KEY12: sw[11].B, d[11].Anode
    net KEY13: sw[12].B, d[12].Anode
    // Matrix nets regrouped by PHYSICAL row/column so each ROW is a short
    // horizontal run and each COL a short vertical run (position-aware — cuts
    // the crossings the old index-order grouping created). Every key keeps a
    // unique (row, col) scan position.
    //   phys rows (by y):   r0={sw0,sw1}          r1={sw2,sw3,sw4,sw5}
    //                       r2={sw6,sw7,sw8,sw9}  r3={sw10,sw11,sw12}
    //   phys cols (by x):   c0={sw2,sw6}          c1={sw0,sw3,sw7,sw10}
    //                       c2={sw1,sw4,sw8,sw11} c3={sw5,sw9,sw12}
    net ROW0: mcu.PA9, sw[0, 1].A
    net ROW1: mcu.PA10, sw[2..=5].A
    net ROW2: mcu.PB3, sw[6..=9].A
    net ROW3: mcu.PB8, sw[10..=12].A
    net COL0: mcu.PB4, d[2, 6].Cathode
    net COL1: mcu.PB5, d[0, 3, 7, 10].Cathode
    net COL2: mcu.PC14, d[1, 4, 8, 11].Cathode
    net COL3: mcu.PC13, d[5, 9, 12].Cathode

    // ---- rotary encoder + push ----
    net ENC_A: mcu.PB12, enc.A
    net ENC_B: mcu.PB13, enc.B
    net ENC_SW: mcu.PB15, enc.SW1

    // ---- analog joystick (X/Y wipers to ADC) + push ----
    net JOY_X: mcu.PB1, joy.X_WIPER
    net JOY_Y: mcu.PA0, joy.Y_WIPER
    net JOY_SW: mcu.PA15, joy.SW_A

    // ---- capacitive touch ----
    net TOUCH: mcu.PB9, touch.PAD

    // ---- addressable RGB (5V; two independent WS2812 chains) ----
    // ---- per-key RGB chain (key_leds[0]..key_leds[12] on LED_DATA_KEY) ----
    net LED_D0: mcu.PA8, key_leds[0].DIN
    net LED_D1: key_leds[0].DOUT, key_leds[1].DIN
    net LED_D2: key_leds[1].DOUT, key_leds[2].DIN
    net LED_D3: key_leds[2].DOUT, key_leds[3].DIN
    net LED_D4: key_leds[3].DOUT, key_leds[4].DIN
    net LED_D5: key_leds[4].DOUT, key_leds[5].DIN
    net LED_D6: key_leds[5].DOUT, key_leds[6].DIN
    net LED_D7: key_leds[6].DOUT, key_leds[7].DIN
    net LED_D8: key_leds[7].DOUT, key_leds[8].DIN
    net LED_D9: key_leds[8].DOUT, key_leds[9].DIN
    net LED_D10: key_leds[9].DOUT, key_leds[10].DIN
    net LED_D11: key_leds[10].DOUT, key_leds[11].DIN
    net LED_D12: key_leds[11].DOUT, key_leds[12].DIN

    // ---- perimeter underglow chain (ambient_leds[0]..ambient_leds[7] on LED_DATA_UG) ----
    net UG_D0: mcu.PB14, ambient_leds[0].DIN
    net UG_D1: ambient_leds[0].DOUT, ambient_leds[1].DIN
    net UG_D2: ambient_leds[1].DOUT, ambient_leds[2].DIN
    net UG_D3: ambient_leds[2].DOUT, ambient_leds[3].DIN
    net UG_D4: ambient_leds[3].DOUT, ambient_leds[4].DIN
    net UG_D5: ambient_leds[4].DOUT, ambient_leds[5].DIN
    net UG_D6: ambient_leds[5].DOUT, ambient_leds[6].DIN
    net UG_D7: ambient_leds[6].DOUT, ambient_leds[7].DIN

    // ---- unused pins ----
    // chain ends float (last DOUT of each chain); SBU unused
    nc: mcu.NRST, usbc.SBU1, usbc.SBU2, key_leds[12].DOUT, ambient_leds[7].DOUT
    nc: mcu.PC15, mcu.PA1, mcu.PA2, mcu.PA3, mcu.PA4, mcu.PA5, mcu.PA6, mcu.PA7, mcu.PB0, mcu.PB2,
        mcu.PB10, mcu.PB11

    // ---- layout: fixed user-facing parts placed; MCU + passives staged ----
    // Physical arrangement transcribed from the Work Louder Creator Micro 2 /
    // Codex Micro layout diagram: a SQUARE macropad, 4x4 cells on a 19.05mm grid
    // (columns/rows at -28.575, -9.525, +9.525, +28.575). Corners of the top row
    // hold the ROTARY ENCODER (top-LEFT) and the PLANAR JOYSTICK (top-RIGHT); the
    // bottom-left cell holds the cap-TOUCH sensor. The 13 mechanical switches are
    // k1..k13: k1/k2 fill the top-row middle, k3..k10 the two middle rows, and
    // the bottom row is k11+k12 (two switches under a single 2U keycap, spanning
    // the middle two columns) plus k13 at the right. `enc`'s origin is
    // back-offset by its footprint courtyard centre so the knob lands on its
    // corner cell; `joy`'s footprint is referenced to the lever axis itself, so
    // it needs no offset.
    layout {
        diff_pair(USBC_DP,
                  USBC_DM) [differential_impedance: 100ohm, single_ended_impedance: 50ohm, frequency: 1GHz]
        diff_pair(USB_DP,
                  USB_DM) [differential_impedance: 100ohm, single_ended_impedance: 50ohm, frequency: 1GHz]
        board_outline: "mechanical/openmicro-outline.dxf"
        // MCU on the BACK (RFC-026 side bottom), in the LEFT MARGIN at mid
        // height, turned a quarter turn. This position was derived, not chosen:
        // Quilter failed to route the previous placement, and a search over
        // every legal bottom-side position and cardinal rotation — scoring
        // total net length and, more importantly, how many of the 48 pads can
        // escape the package outline without immediately hitting something —
        // put the optimum here. It is the only candidate where ALL 48 pads
        // escape. See docs/compliance-report.md for the measurements.
        //
        // Two earlier placements are superseded, and both failed for the same
        // underlying reason: a QFP-48 on 0.5mm pitch is routed almost entirely
        // by vias inside its own outline, so it needs a free collar all the way
        // round, and both earlier spots were wedged into a pocket.
        //
        //   - beneath the cap-touch pad, square: cleared the electrode by only
        //     0.44mm, in Y, with the crystal hard against its west face.
        //   - the same pocket turned 45 degrees: a 9.39mm courtyard becomes a
        //     13.28mm diamond, and the pocket is 14.28mm. One millimetre of
        //     slack for the whole part, 0.36mm to the board edge, and the
        //     diamond ate its own fanout collar — 56% of the 3mm collar free
        //     against 84% for the same part square. The diagonal was the point
        //     of the turn, but on a 2-LAYER board the collar is the routing
        //     resource, and turning the package spent it.
        //
        // The left margin has no such pocket. The package clears the electrode
        // by 1.94mm in X — separation in the axis that matters, rather than a
        // 0.44mm Y-margin under it — so the via-through-electrode problem is
        // gone by construction, not by a tight margin. Board edge clearance is
        // 2.81mm, up from 0.36mm.
        //
        // Every net that matters got shorter, not longer, which is unusual for
        // a placement move and worth recording: TOUCH sense 16.9 -> 7.8mm, USB
        // FS pair 77.7 -> 68.6mm, HSE loop 10.10 -> 6.90mm (shorter than the
        // 8.82mm it was BEFORE the 45-degree experiment), total net length
        // 1691.7 -> 1626.2mm.
        //
        // Note the GPIO map in openmicro_parts.cohdl was assigned position-aware
        // for a long-superseded TOP-left location. It has now been wrong for
        // three placements running; re-deriving it is the obvious next lever if
        // routing is still tight.
        place mcu at (-40mm, 24mm) rotate 270 side bottom
        // HSE tank on the BACK, on the MCU's +y face where PF0/PF1 now come out
        // (y 28.16, just inside the courtyard edge at 28.745). Unlike the
        // 45-degree placement — whose diagonal pin normal pointed at the board
        // corner, leaving nowhere for the tank and forcing it off to one side —
        // this face looks into open left-margin space, so the tank sits square
        // in front of the pins it serves.
        //
        // That is why the oscillator loop is now 6.90mm (4.22 + 2.68), SHORTER
        // than the 8.82mm of the original square placement and well under the
        // 10.10mm the 45-degree version cost. AN2867 wants a short loop and
        // quiet neighbours; this is the best of the three.
        //
        // `rotate 180` because the 3225 land puts XIN and XOUT on opposite
        // corners, so no quarter turn faces both pins — the choice is which
        // diagonal points at the package. 180 is the balanced one here. Load
        // caps flank the tank, each beside the terminal it loads, 2.26mm and
        // 2.83mm out.
        place xtal at (-39.5mm, 31.5mm) side bottom
        place c_x1 at (-36.2mm, 33.8mm) rotate 180 side bottom
        place c_x2 at (-42.8mm, 31.5mm) rotate 180 side bottom
        place enc at (-35.575mm, -31.075mm)
        place sw[0] at (-9.525mm, -28.575mm)
        place sw[1] at (9.525mm, -28.575mm)
        // FP_Joystick_RKJXV's origin is the LEVER AXIS (the datasheet's ø4
        // keep-out centre), so the stick sits exactly on the corner cell —
        // no courtyard-centre back-offset, unlike the placeholder footprint
        // this replaced. Rotation therefore does not move the stick.
        //
        // `rotate 180` because the body is NOT symmetric about that axis: at the
        // height a keycap occupies (3.5-5mm above the board) it reaches 10.90mm
        // on the centre-push side and 10.54mm on the potentiometer side. Turning
        // the narrower side toward the key below buys clearance for free, and
        // incidentally swings the VR1 terminal column inboard, toward the MCU
        // its wipers run to.
        //
        // Shifted 1mm toward the board edge into the depth the ring push freed:
        // the body is 22.7mm deep in a 19.05mm cell, so the corner cell alone
        // cannot hold it. 1mm is what turns a keycap graze into real clearance;
        // the stick moves 1mm off the cell centre, which is the trade.
        //
        // Also shifted 1mm right (+x) — the same problem in the other axis,
        // reported off the built board: the body's west face sat 18.225 from
        // centre at its widest, essentially touching sw[1]'s 17.5mm keycap
        // edge at 18.275. The +x side holds nothing but board edge, so the
        // millimetre is free; body-to-body gap to sw[1] goes 0.9 -> 1.9mm.
        place joy at (29.575mm, -29.575mm) rotate 180
        // middle two rows: k3..k6, k7..k10
        place sw[2] at (-28.575mm, -9.525mm)
        place sw[3] at (-9.525mm, -9.525mm)
        place sw[4] at (9.525mm, -9.525mm)
        place sw[5] at (28.575mm, -9.525mm)
        place sw[6] at (-28.575mm, 9.525mm)
        place sw[7] at (-9.525mm, 9.525mm)
        place sw[8] at (9.525mm, 9.525mm)
        place sw[9] at (28.575mm, 9.525mm)
        // Debug/serial socket on the BACK, centred on the bottom edge in the gap
        // (the bottom edge is now clear end to end — the ring that used to
        // flank this socket is gone):
        // this is the only edge not already owned by the USB-C, the joystick or
        // the encoder, and the back is where a debug socket belongs on a
        // keyboard — reachable with the board out of its case, invisible in it.
        // y = 43, not 43.5: the 8.3mm courtyard would otherwise cross the board
        // edge at 47.55.
        place swd at (0mm, 43mm) rotate 180 side bottom
        // bottom row: touch (BL corner), k11+k12 under the 2U cap, k13
        place touch at (-28.575mm, 28.575mm)
        place sw[10] at (-9.525mm, 28.575mm)
        place sw[11] at (9.525mm, 28.575mm)
        place sw[12] at (28.575mm, 28.575mm)
        // matrix diodes: back side, one south of each key, vertical, aligned
        // under the switch's B-contact column (RFC-026 side bottom)
        place d[0] at (-4.525mm, -19.825mm) rotate 270 side bottom
        place d[1] at (14.525mm, -19.825mm) rotate 270 side bottom
        place d[2] at (-23.575mm, -0.775mm) rotate 270 side bottom
        place d[3] at (-4.525mm, -0.775mm) rotate 270 side bottom
        place d[4] at (14.525mm, -0.775mm) rotate 270 side bottom
        place d[5] at (33.575mm, -0.775mm) rotate 270 side bottom
        place d[6] at (-23.575mm, 18.275mm) rotate 270 side bottom
        place d[7] at (-4.525mm, 18.275mm) rotate 270 side bottom
        place d[8] at (14.525mm, 18.275mm) rotate 270 side bottom
        place d[9] at (33.575mm, 18.275mm) rotate 270 side bottom
        // last row sits 1.5mm higher than the 8.75mm pitch: the debug socket
        // owns the bottom-edge centre, and d[10] would clip its courtyard
        place d[10] at (-4.525mm, 35.825mm) rotate 270 side bottom
        place d[11] at (14.525mm, 35.825mm) rotate 270 side bottom
        place d[12] at (33.575mm, 35.825mm) rotate 270 side bottom
        // USB-C centered on the top edge (mouth rotated to face off the -y edge)
        // HRO datasheet: PCB EDGE is 1.86mm from the footprint origin on the
        // mouth side (shell front overhangs ~1.8mm). Top edge at y=-47.5 ->
        // origin at -47.5 + 1.86 = -45.64.
        //
        // On the BACK, with the MCU: the bottom is this board's component side,
        // so the receptacle's SMD contacts land on B.Cu beside the MCU they
        // serve. Its four shield legs are through-holes and span the board
        // either way.
        //
        // `rotate 180`, same as the front-side placement this replaced. The
        // footprint is drawn mouth-toward +y (the datasheet's PCB EDGE line sits
        // 1.86mm on the +y side of the origin), and RFC-026's back-side flip is
        // a pure left/right mirror — it never turns the mouth — so a top-edge
        // mouth keeps its rotate 180 on either side. It lands the PCB EDGE
        // exactly on y = -47.5. (An earlier revision dropped the 180 to cancel
        // a kicad_board.py bug that flipped top/bottom instead; the tool is
        // fixed and the workaround is gone.)
        place usbc at (0mm, -45.64mm) rotate 180 side bottom
        // ESD array on the BACK too, on the board centreline directly inboard
        // of the receptacle. A TVS clamp belongs at the connector, not at the
        // far end of the line it protects, so what matters is the UNPROTECTED
        // USBC_* stretch staying short — straight down the centreline it is now
        // 3.26mm per line, down from 6.4mm at the old off-centre spot.
        //
        // Turned a quarter turn from the old orientation so the two lead rows
        // run ACROSS the board rather than along it: the connector-side
        // terminals (pads 1/3) face -y toward the receptacle and the MCU-side
        // terminals (pads 4/6) face +y toward the rest of the board. Paired
        // with the DP/DM channel swap above, each line stays on its own side.
        //
        // y = -37.2 is the first position clear of the receptacle courtyard
        // (which ends at -39.34); it also sits in the 3.46mm gap between SW3
        // and SW4, though those are front-side parts and share no layer.
        place esd at (0mm, -37.2mm) rotate 90 side bottom
        // per-key RGB LEDs: reverse-mount in the SOUTH LED window, offset in y
        // from each switch stem so the LED clears the contacts, the central box
        // hole, and the mounting peg. On the BACK (RFC-026): a reverse-mount
        // emitter fires through the board, so lighting a top-side switch means
        // sitting under it. The perimeter ring below stays on the FRONT, where
        // its light escapes around the board edge instead.
        // `rotate 180` on every one: the SK6812MINI-E land puts DOUT and DIN on
        // OPPOSITE columns (DOUT west, DIN east as drawn), and the chain runs
        // left-to-right along each row. Unrotated, every in-row hop had to
        // double back past the LED body — 24.5mm to cross a 19.05mm pitch.
        // Turned around, DOUT faces the next LED's DIN and the hop is 13.7mm
        // of straight run. Nine in-row hops save 10.9mm each; the three
        // end-of-row wraps pay 11.2mm more, since the chain now finishes each
        // row at the far side. Net: 349.6mm -> 285.3mm of LED data net.
        place key_leds[0] at (-9.53mm, -23.64mm) side bottom
        place key_leds[1] at (9.53mm, -23.64mm) side bottom
        place key_leds[2] at (-28.57mm, -4.6mm) side bottom
        place key_leds[3] at (-9.53mm, -4.6mm) side bottom
        place key_leds[4] at (9.53mm, -4.6mm) side bottom
        place key_leds[5] at (28.57mm, -4.6mm) side bottom
        place key_leds[6] at (-28.57mm, 14.46mm) side bottom
        place key_leds[7] at (-9.53mm, 14.46mm) side bottom
        place key_leds[8] at (9.53mm, 14.46mm) side bottom
        place key_leds[9] at (28.57mm, 14.46mm) side bottom
        place key_leds[10] at (-9.53mm, 33.5mm) side bottom
        place key_leds[11] at (9.53mm, 33.5mm) side bottom
        place key_leds[12] at (28.57mm, 33.5mm) side bottom
        // Perimeter underglow ring: 8 LEDs, 2 per side, at the THIRDS of each
        // 95mm edge (x = ±15.833), 4.0mm inset. Thirds keep the spacing regular
        // around the corners as well as along an edge — 31.67mm between
        // neighbours on an edge, 39.13mm diagonally across a corner.
        //
        // Restored after a spell removed. Its real cost is not the parts: each
        // SK6812 is REVERSE-MOUNT, so it carries a 3.4 x 3.0mm `window`, and a
        // window is an Edge.Cuts aperture — a hole that blocks BOTH copper
        // layers. Eight of them narrow the outer routing collar from 88.5% to
        // 83.9% free on a 2-LAYER board, and that collar is the natural path
        // for rail and matrix nets crossing the key field. The GPIO map was
        // re-derived for the current MCU placement to buy that back; see
        // openmicro_parts.cohdl.
        //
        // The top (USB-side) and left LEDs carry an extra 180 degrees: the
        // SK6812's DOUT and DIN sit at opposite ends of the package, so on
        // those two edges the unrotated part points DOUT away from the next LED
        // and each hop spans the whole neighbour (37.1mm instead of 26.2mm at
        // this 31.67mm pitch).
        place ambient_leds[0] at (-15.833mm, -43.5mm) rotate 180
        place ambient_leds[1] at (15.833mm, -43.5mm) rotate 180
        place ambient_leds[2] at (43.5mm, -15.833mm) rotate 90
        place ambient_leds[3] at (43.5mm, 15.833mm) rotate 90
        place ambient_leds[4] at (15.833mm, 43.5mm)
        place ambient_leds[5] at (-15.833mm, 43.5mm)
        place ambient_leds[6] at (-43.5mm, 15.833mm) rotate 270
        place ambient_leds[7] at (-43.5mm, -15.833mm) rotate 270
        // M2 mounting holes at the four corners (5mm edge inset)
        place mh[0] at (-42.5mm, -42.5mm)
        place mh[1] at (42.5mm, -42.5mm)
        place mh[2] at (42.5mm, 42.5mm)
        place mh[3] at (-42.5mm, 42.5mm)
    }
}
